---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Avatar from '../components/Avatar.astro';
import WorldGame from '../components/WorldGame.astro';
import Digging from '../components/Digging.astro';
import Boss from '../components/Boss.astro';
import Crafting from '../components/Crafting.astro';
import { assertRecipeSkills } from '../lib/recipes';
import { features } from '../site.config';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
assertRecipeSkills(projects, skills);
const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const firstSkill = skills[0].data;
const skillIcons: Record<string, string> = { brush:'hammer', palette:'gem', branch:'flag', bolt:'sparkle' };
---
<Layout>
  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="stars" aria-hidden="true"></div><div class="sun" aria-hidden="true"></div>
    <img class="world-art" src={features.hero ? '/art/world-play.svg' : '/art/world.svg'} alt="An original pixel forest with layered hills, a woodland cottage, wildflowers, and a tiny adventurer." width="1600" height="600" fetchpriority="high"/>
    <WorldGame/>
    <div class="hero-content container">
      <div class="hero-copy"><span class="spawn-badge"><span></span> A NEW ADVENTURE AWAITS</span><h1 id="hero-title">Crafting code.<br/><span>Exploring ideas.</span></h1><p>Hey, I’m Alex — a frontend developer.<br/>I turn curious ideas into thoughtful<br class="desktop-br"/> digital experiences, one pixel at a time.</p><div class="hero-actions"><a class="pixel-button" href="#projects"><Icon name="chest" size={20}/> Explore my work <span aria-hidden="true">↓</span></a><button class="pixel-button secondary" type="button" data-open-dialog><Icon name="person" size={20}/> Say hello</button></div></div>
      <div class="world-label"><span class="eyebrow">WORLD 01</span><span>The creative wilderness</span><span class="world-dots" aria-hidden="true">▪ ▪ ▪</span></div>
      <div class="npc-world"><button class="speech-bubble" type="button" data-open-dialog>Oh, a new adventurer!<br/><span>Stay a while. Look around.</span><span class="bubble-key" aria-hidden="true">↗</span></button><div class="wanderer"><Avatar size={72}/><span>Pixel the Wanderer</span></div></div>
    </div>
    <div class="biome-strip" data-weather-hud={features.weather || undefined}><div class="container"><span><span class="biome-dot"></span><span class="biome-name">Forest biome</span>{features.weather ? <span class="biome-weather" data-weather-label>Clear skies</span> : <span class="biome-extra"> / Creativity grows here</span>}</span><a href="#projects">Scroll to explore <span aria-hidden="true">↓</span></a></div></div>
  </section>

  <div class="underground">
    {features.digging && <Digging variant="world"/>}
    <section class="projects-section container" id="projects" aria-labelledby="projects-title">
      <div class="section-topline"><span class="eyebrow">01 / THE INVENTORY</span><span class="collection-label"><Icon name="chest" size={16}/> <span id="project-count" aria-live="polite">3 items</span> collected</span></div>
      <div class="section-toolbar"><div><div class="section-heading"><h2 id="projects-title">Things I’ve crafted<span class="heading-dot">.</span></h2></div><p class="section-description">A few favorite ideas from the workbench.</p></div><div class="filters" role="group" aria-label="Filter projects"><button type="button" data-filter="all" aria-pressed="true">All items</button><button type="button" data-filter="Web apps" aria-pressed="false">Web apps</button><button type="button" data-filter="Creative tools" aria-pressed="false">Creative tools</button></div></div>
      <div class="project-grid">
        {projects.map((project) => <article class="project-card" data-project data-project-id={project.id} data-category={project.data.category}>
          <a href={`/projects/${project.id}/`} class="project-image-link" aria-label={`Explore ${project.data.title}`}><img src={project.data.image} alt={`${project.data.title} original pixel-art concept illustration`} width="600" height="280" loading="lazy"/><span class:list={['rarity-badge', project.data.rarity.toLowerCase()]}><span aria-hidden="true">◆</span> {project.data.rarity}</span><span class="concept-badge">CONCEPT</span></a>
          <div class="project-content"><div class="project-title-row"><h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3><Icon name={project.data.icon} size={20}/></div><p>{project.data.tagline}</p><div class="project-bottom"><div class="stack">{project.data.stack.slice(0,3).map(tech => <span>{tech}</span>)}</div><a href={`/projects/${project.id}/`} class="project-arrow" aria-label={`Read ${project.data.title} case study`}><Icon name="arrow" size={20}/></a></div></div>
        </article>)}
      </div>
      <p class="inventory-hint"><Icon name="sparkle" size={12}/> Every project starts with “what if?” <span>Pick an item to inspect it.</span></p>
      {features.digging && <Digging variant="guide"/>}
    </section>

    <section class="skills-section container" id="skills" aria-labelledby="skills-title">
      <div class="skills-intro"><span class="eyebrow">02 / THE LOADOUT</span><div class="section-heading"><h2 id="skills-title">Tools of the trade.</h2></div><p class="section-description">A well-equipped adventurer<br/>is ready for any quest.</p><div class="active-buffs"><span class="eyebrow">ACTIVE BUFFS</span><div class="buffs"><span class="buff" tabindex="0"><Icon name="potion" size={20}/><span class="buff-tooltip" role="tooltip">Curiosity<br/><small>Always asking “what if?”</small></span></span><span class="buff" tabindex="0"><Icon name="heart" size={20}/><span class="buff-tooltip" role="tooltip">Empathy<br/><small>People before pixels.</small></span></span><span class="buff" tabindex="0"><Icon name="sun" size={20}/><span class="buff-tooltip" role="tooltip">Persistence<br/><small>One small improvement at a time.</small></span></span><p>Curious by default.<br/>Always learning.</p></div></div></div>
      <div class="inventory-panel panel"><div class="inventory-header"><span><Icon name="pickaxe" size={16}/> Equipped skills</span><span>8 / 8 slots</span></div><div class="skills-layout"><div class="skill-grid">{skills.map((skill, index) => <button type="button" class:list={['skill-slot', {equipped:index === 0}]} data-skill={skill.id} data-name={skill.data.name} data-description={skill.data.description} data-rarity={skill.data.rarity} data-category={skill.data.category} aria-pressed={index===0} aria-label={`Inspect ${skill.data.name}`}><span class="skill-slot-number" aria-hidden="true">{index+1}</span><Icon name={skillIcons[skill.data.icon] ?? skill.data.icon} size={32}/><span class="skill-name">{skill.data.name}</span><span class="item-tooltip" role="tooltip"><strong>{skill.data.name}</strong><span>{skill.data.category} · {skill.data.rarity}</span></span></button>)}</div><div class="skill-detail" aria-live="polite"><span class="eyebrow">SELECTED ITEM</span><h3 id="skill-name">{firstSkill.name}</h3><p class="item-type"><span id="skill-rarity">{firstSkill.rarity}</span> <span id="skill-category">{firstSkill.category}</span> tool</p><p id="skill-description">{firstSkill.description}</p><span class="equipped-label"><Icon name="check" size={12}/> Ready to craft</span></div></div><div class="inventory-footer"><span>Hover to discover. Click to inspect.</span><span aria-hidden="true">✦</span></div></div>
      {features.crafting && <Crafting projects={projects} skills={skills}/>}
    </section>

    <section class="journey-section container" id="about" aria-labelledby="about-title">
      <div class="about-card panel"><div class="about-title"><div class="profile-portrait"><Avatar size={80}/></div><div><span class="eyebrow">03 / THE PLAYER</span><h2 id="about-title">A builder at heart.</h2><span class="player-class">Class: Frontend explorer</span></div></div><p>I like the space where thoughtful design meets working code. The tiny details. The satisfying interactions. The feeling that someone really cared.</p><p>When I’m not experimenting with interfaces, you’ll find me exploring game worlds, sketching ideas, or taking the scenic route.</p><div class="player-traits"><span><Icon name="heart" size={16}/> People first</span><span><Icon name="leaf" size={16}/> Always growing</span><span><Icon name="sparkle" size={16}/> Detail driven</span></div></div>
      <div class="quest-log"><div class="section-heading"><Icon name="book" size={24}/><h2>My quest log</h2></div><p class="section-description">The habits behind the things I make.</p><ol>{experience.map(entry => <li><span class="quest-marker" aria-hidden="true"></span><span class="eyebrow">{entry.data.period}</span><h3>{entry.data.title}</h3><p>{entry.data.description}</p><div class="quest-tags">{entry.data.tags.map(tag => <span>{tag}</span>)}</div></li>)}</ol><Boss variant="shelf"/></div>
    </section>

    <section class="achievements-section container" aria-labelledby="achievements-title"><div class="achievements-heading"><div class="section-heading"><Icon name="trophy" size={20}/><h2 id="achievements-title">Little milestones</h2></div><span id="achievement-count">0 / 3 unlocked</span></div><div class="achievements-grid">{[{id:'explorer',name:'Leave no stone unturned',description:'Visit every part of this world.',icon:'flag'},{id:'night',name:'A different kind of light',description:'Explore the world after dark.',icon:'moon'},{id:'friend',name:'A friendly face',description:'Say hello to Pixel the Wanderer.',icon:'person'}].map(achievement => <div class="achievement" data-achievement={achievement.id}><div class="achievement-icon"><Icon name={achievement.icon} size={28}/></div><div><span class="achievement-state" data-achievement-state>Locked</span><h3>{achievement.name}</h3><p>{achievement.description}</p></div></div>)}</div></section>

    <section class="contact-section container" id="contact" aria-labelledby="contact-title"><div class="contact-art" aria-hidden="true"><Icon name="campfire" size={24}/><div class="campfire"><span></span><i></i></div></div><span class="eyebrow">04 / THE NEXT ADVENTURE</span><h2 id="contact-title">Good things start with a hello.</h2><p>Have a curious idea or a new quest in mind?<br/>There’s always room for another adventurer.</p><button class="pixel-button" type="button" data-open-dialog><Icon name="mail" size={20}/> Let’s talk <span aria-hidden="true">↗</span></button><span class="contact-footnote">Find me by the campfire.</span></section>
  </div>
</Layout>

<style>
  .hero { height:calc(150 * var(--px)); position:relative; overflow:hidden; background:linear-gradient(var(--color-sky-top), var(--color-sky-bottom)); isolation:isolate; }
  .world-art { position:absolute; width:100%; height:100%; inset:0; object-fit:cover; object-position:center bottom; z-index:-1; }
  .hero-content { height:100%; position:relative; pointer-events:none; z-index:2; }
  .hero-content a, .hero-content button { pointer-events:auto; }
  .hero-copy { padding-top:calc(17 * var(--px)); position:relative; z-index:2; }
  .spawn-badge { display:inline-flex; align-items:center; gap:calc(2 * var(--px)); color:#e1f0d9; background:#233c48; box-shadow:var(--px) var(--px) 0 #163047; padding:calc(2 * var(--px)) calc(3 * var(--px)); font-size:calc(3 * var(--px)); letter-spacing:calc(.5 * var(--px)); }
  .spawn-badge > span { width:calc(1.5 * var(--px)); height:calc(1.5 * var(--px)); background:#b8df8e; }
  h1 { margin-top:calc(5 * var(--px)); font-size:calc(17 * var(--px)); font-weight:700; line-height:1.04; letter-spacing:calc(-.5 * var(--px)); color:#f5f5dc; text-shadow:var(--px) var(--px) 0 #213b46, calc(-.5 * var(--px)) 0 0 #213b46, 0 calc(-.5 * var(--px)) 0 #213b46; }
  h1 > span { color:#fff0b4; }
  .hero-copy > p { margin-top:calc(6 * var(--px)); margin-left:calc(-3 * var(--px)); padding:calc(2 * var(--px)) calc(3 * var(--px)); width:fit-content; background:#d7eee7e8; color:#19394a; font-size:calc(5 * var(--px)); line-height:1.45; }
  .hero-actions { margin-top:calc(7 * var(--px)); display:flex; gap:calc(4 * var(--px)); }
  .hero-actions .pixel-button { box-shadow:var(--bevel), 0 var(--px) 0 #192c34; }
  .world-label { position:absolute; top:calc(9 * var(--px)); right:0; display:grid; text-align:right; gap:var(--px); color:#e0eaf2; font-size:calc(3 * var(--px)); padding:calc(2 * var(--px)) calc(3 * var(--px)); background:#20374bea; border:calc(.5 * var(--px)) solid #839fab; }
  .world-label .eyebrow { color:#bbd2df; font-size:calc(2.5 * var(--px)); }
  .hero:has([data-boss-visible='true']) .world-label, .hero:has([data-boss-message]:not([hidden])) .world-label { visibility:hidden; }
  .world-dots { letter-spacing:var(--px); opacity:.7; }
  .sun { position:absolute; width:calc(14 * var(--px)); height:calc(14 * var(--px)); background:#fff5bf; top:calc(22 * var(--px)); left:70%; z-index:-1; box-shadow:calc(-2 * var(--px)) 0 0 #fff5bf,calc(2 * var(--px)) 0 0 #fff5bf,0 calc(-2 * var(--px)) 0 #fff5bf,0 calc(2 * var(--px)) 0 #fff5bf; }
  .npc-world { position:absolute; right:calc(32 * var(--px)); bottom:calc(13 * var(--px)); display:flex; flex-direction:column; align-items:center; gap:calc(4 * var(--px)); }
  .speech-bubble { text-align:left; font-size:calc(3.5 * var(--px)); line-height:1.4; background:#f9f2d3; color:#34443e; border:calc(.5 * var(--px)) solid #344f45; padding:calc(3 * var(--px)) calc(8 * var(--px)) calc(3 * var(--px)) calc(4 * var(--px)); box-shadow:var(--px) var(--px) 0 #18394055; position:relative; }
  .speech-bubble::after { content:''; width:calc(2 * var(--px)); height:calc(2 * var(--px)); position:absolute; bottom:calc(-2.5 * var(--px)); left:calc(7 * var(--px)); background:#f9f2d3; border-right:calc(.5 * var(--px)) solid #344f45; border-bottom:calc(.5 * var(--px)) solid #344f45; }
  .speech-bubble > span:not(.bubble-key) { font-size:calc(3 * var(--px)); color:#55725b; }
  .bubble-key { position:absolute; right:calc(3 * var(--px)); top:calc(3 * var(--px)); }
  .wanderer { display:flex; align-items:center; flex-direction:column; gap:var(--px); }
  .wanderer > span { background:#17302acf; padding:var(--px) calc(2 * var(--px)); font-size:calc(2.5 * var(--px)); color:#e3edc9; }
  .biome-strip { position:absolute; bottom:0; width:100%; z-index:3; background:#142b24e8; border-top:calc(.5 * var(--px)) solid #71924c; padding:calc(2 * var(--px)) 0; font-size:calc(3 * var(--px)); color:#c5d7ae; }
  .biome-strip .container { display:flex; align-items:center; justify-content:space-between; }
  .biome-dot { display:inline-block; width:calc(1.5 * var(--px)); height:calc(1.5 * var(--px)); background:#afd473; margin-right:calc(2 * var(--px)); }
  .biome-extra { color:#a2b494; }
  .biome-weather { color:#cedcc0; }
  .biome-weather::before { content:' / '; }
  @media(max-width:700px) { .biome-strip[data-weather-hud] .biome-name, .biome-strip[data-weather-hud] a { display:none; } .biome-weather::before { content:''; } }
  .biome-strip a > span { margin-left:calc(4 * var(--px)); }
  .stars { display:none; position:absolute; inset:0; background-image:radial-gradient(#fff5 1px, transparent 1px); background-size:calc(17 * var(--px)) calc(19 * var(--px)); z-index:-1; }
  :global([data-theme='night']) .stars { display:block; }
  :global([data-theme='night']) .world-art { filter:brightness(.57) saturate(.7); }
  :global([data-theme='night']) .hero:has([data-lighting='on']) .world-art { filter:none; }
  :global([data-theme='night']) .sun { background:#e2e8f2; box-shadow:calc(-2 * var(--px)) 0 0 #e2e8f2, calc(2 * var(--px)) 0 0 #e2e8f2, 0 calc(-2 * var(--px)) 0 #e2e8f2, 0 calc(2 * var(--px)) 0 #e2e8f2; }
  :global([data-theme='night']) .sun::after { content:''; position:absolute; width:calc(4 * var(--px)); height:calc(4 * var(--px)); left:calc(2 * var(--px)); top:calc(3 * var(--px)); background:#b5bfd5; box-shadow:calc(6 * var(--px)) calc(6 * var(--px)) 0 #b5bfd5; }
  :global([data-theme='night']) .hero-copy > p { color:#e2e8f7; background:#142349e8; }
  :global([data-theme='night']) .world-label, :global([data-theme='night']) .world-label .eyebrow { color:#a9bfd9; }
  .underground { background-color:var(--color-bg); background-image:linear-gradient(90deg, #7487b504 calc(.5 * var(--px)), transparent calc(.5 * var(--px))), linear-gradient(#7487b504 calc(.5 * var(--px)), transparent calc(.5 * var(--px))); background-size:calc(12 * var(--px)) calc(12 * var(--px)); border-top:var(--px) solid #304039; }
  .projects-section { padding-top:calc(14 * var(--px)); }
  .section-topline { display:flex; align-items:center; justify-content:space-between; margin-bottom:calc(3 * var(--px)); }
  .collection-label { display:flex; align-items:center; gap:calc(2 * var(--px)); font-size:calc(3 * var(--px)); color:var(--color-muted); }
  .collection-label svg { color:#9fae9b; }
  .section-toolbar { display:flex; justify-content:space-between; align-items:center; gap:calc(6 * var(--px)); margin-bottom:calc(7 * var(--px)); }
  .section-toolbar h2 { font-size:calc(9 * var(--px)); }
  .heading-dot { color:var(--color-accent); }
  .section-description { color:var(--color-muted); font-size:calc(4 * var(--px)); }
  .filters { display:flex; gap:var(--px); background:#0d152d; border:calc(.5 * var(--px)) solid #36466d; padding:var(--px); }
  .filters button { background:transparent; color:#bcc7e2; padding:calc(2 * var(--px)) calc(3 * var(--px)); font-size:calc(3 * var(--px)); min-height:calc(9 * var(--px)); }
  .filters button[aria-pressed='true'] { background:#37446a; box-shadow:inset 0 calc(.5 * var(--px)) 0 #5f6c92; color:#f4edbe; }
  .filters button:hover { color:#fff; background:#263459; }
  .project-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:calc(5 * var(--px)); }
  .project-card { border:calc(.5 * var(--px)) solid #52628c; background:#1a274c; box-shadow:0 var(--px) 0 #090f25; transition:transform 120ms steps(2), border-color 120ms; }
  .project-card:hover, .project-card:focus-within { transform:translateY(calc(-1 * var(--px))); border-color:#a6b591; }
  .project-image-link { display:block; position:relative; border-bottom:calc(.5 * var(--px)) solid #4d5c83; overflow:hidden; background:#1e3047; }
  .project-image-link img { width:100%; height:calc(43 * var(--px)); object-fit:cover; display:block; }
  .rarity-badge { position:absolute; top:calc(3 * var(--px)); left:calc(3 * var(--px)); background:#15213fee; padding:var(--px) calc(2 * var(--px)); font-size:calc(3 * var(--px)); border:calc(.5 * var(--px)) solid currentColor; }
  .rare { color:var(--rarity-blue); } .epic { color:var(--rarity-purple); } .legendary { color:var(--rarity-orange); }
  .concept-badge { position:absolute; bottom:calc(2 * var(--px)); right:calc(2 * var(--px)); font-size:calc(2.5 * var(--px)); background:#0d152adb; padding:var(--px) calc(2 * var(--px)); color:#e1e4ec; letter-spacing:calc(.25 * var(--px)); }
  .project-content { padding:calc(5 * var(--px)); }
  .project-title-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:calc(2 * var(--px)); }
  .project-title-row h3 { font-size:calc(6 * var(--px)); font-weight:400; color:#f3f2df; }
  .project-title-row svg { color:#9babc7; }
  .project-content > p { color:#b9c3df; font-size:calc(3.5 * var(--px)); min-height:calc(12 * var(--px)); }
  .project-bottom { display:flex; justify-content:space-between; align-items:center; gap:calc(2 * var(--px)); margin-top:calc(5 * var(--px)); }
  .stack { display:flex; flex-wrap:wrap; gap:calc(1.5 * var(--px)); }
  .stack > span { color:#c1cee6; font-size:calc(2.5 * var(--px)); background:#26345b; padding:var(--px) calc(2 * var(--px)); border:calc(.25 * var(--px)) solid #415177; }
  .project-arrow { display:grid; place-items:center; color:#e2e4b8; min-width:calc(10 * var(--px)); min-height:calc(10 * var(--px)); background:#2c3c58; border:calc(.5 * var(--px)) solid #5f708b; box-shadow:var(--bevel); }
  .project-arrow:hover { color:white; background:#45624b; }
  .inventory-hint { display:flex; align-items:center; gap:calc(2 * var(--px)); margin-top:calc(5 * var(--px)); color:#a4b0d0; font-size:calc(3 * var(--px)); }
  .inventory-hint svg { color:var(--color-accent); }
  .inventory-hint > span { margin-left:auto; color:#94a3c7; }
  .skills-section { display:grid; grid-template-columns:1fr 2fr; gap:calc(10 * var(--px)); padding-block:calc(17 * var(--px)); margin-top:calc(15 * var(--px)); border-top:calc(.5 * var(--px)) solid #2e3e62; border-bottom:calc(.5 * var(--px)) solid #2e3e62; }
  .skills-intro > .section-heading { margin-top:calc(3 * var(--px)); }
  .active-buffs { margin-top:calc(6 * var(--px)); }
  .active-buffs > .eyebrow { font-size:calc(2.5 * var(--px)); }
  .buffs { display:flex; gap:calc(2 * var(--px)); align-items:center; margin-top:calc(2 * var(--px)); }
  .buff { display:grid; place-items:center; position:relative; width:calc(10 * var(--px)); height:calc(10 * var(--px)); border:calc(.5 * var(--px)) solid #6c7797; background:#24325a; box-shadow:var(--bevel); color:#bfbaeb; }
  .buff:nth-child(2) { color:#efaea9; } .buff:nth-child(3) { color:#e9d497; }
  .buffs > p { font-size:calc(2.5 * var(--px)); color:#a8b7cf; padding-left:var(--px); }
  .buff-tooltip, .item-tooltip { position:absolute; z-index:10; bottom:calc(100% + 2 * var(--px)); left:50%; transform:translateX(-50%); background:#0e1737; color:#eff3ff; border:calc(.5 * var(--px)) solid #a7b9e4; padding:calc(3 * var(--px)); width:max-content; max-width:calc(50 * var(--px)); text-align:left; box-shadow:var(--px) var(--px) 0 #090e21; font-size:calc(3.5 * var(--px)); pointer-events:none; opacity:0; }
  .buff-tooltip small { color:#b9c4e0; font-size:calc(3 * var(--px)); }
  .buff:not([data-tooltip-hidden]):hover .buff-tooltip, .buff:not([data-tooltip-hidden]):focus .buff-tooltip, .skill-slot:not([data-tooltip-hidden]):hover .item-tooltip, .skill-slot:not([data-tooltip-hidden]):focus-visible .item-tooltip { opacity:1; pointer-events:auto; }
  .buff::after, .skill-slot::after { content:''; position:absolute; bottom:100%; left:0; width:100%; height:calc(3 * var(--px)); }
  .buff:focus-visible { outline:var(--px) solid var(--color-focus); outline-offset:var(--px); }
  .inventory-panel { background:#19274e; }
  .inventory-header { display:flex; align-items:center; justify-content:space-between; background:#26345c; border-bottom:calc(.5 * var(--px)) solid #50638a; padding:calc(3 * var(--px)) calc(4 * var(--px)); }
  .inventory-header > span:first-child { display:flex; align-items:center; gap:calc(2 * var(--px)); font-size:calc(4 * var(--px)); }

---
import Icon from './Icon.astro';
import { features } from '../site.config';
const nav = [ ['home', 'Spawn', 'sword'], ['projects', 'Projects', 'chest'], ['skills', 'Skills', 'pickaxe'], ['about', 'Journey', 'book'], ['contact', 'Contact', 'mail'] ];
const isHome = Astro.url.pathname === '/';
---
<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="brand" aria-label="Alex, return to spawn"><img src="/favicon.svg" width="36" height="36" alt=""/><span>ALEX<span class="brand-sub">DEVELOPER & EXPLORER</span></span></a>
    <nav class="hotbar" aria-label="Main navigation">
      {nav.map(([id, label, icon], index) => <a href={isHome ? `#${id}` : `/#${id}`} class:list={['hotbar-item', { selected: id === 'home' && isHome }]} data-nav={id} aria-label={`${label} — shortcut ${index + 1}`} aria-current={id === 'home' && isHome ? 'location' : undefined}><span class="slot-number" aria-hidden="true">{index + 1}</span><Icon name={icon} size={24}/><span class="slot-label">{label}</span></a>)}
      <button class="hotbar-item" type="button" data-open-settings aria-label="Settings — shortcut 6" aria-haspopup="dialog" aria-controls="settings-dialog" aria-expanded="false"><span class="slot-number" aria-hidden="true">6</span><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M9 1h6v3h3v3h3v6h-3v3h-3v3H9v-3H6v-3H3V7h3V4h3zm0 6v6h6V7zM4 19h4v4H4zm12 0h4v4h-4z"/></svg><span class="slot-label">Settings</span></button>
    </nav>
    <div class="world-controls">
      {features.digging && <span class="loot-count" title="Collected blocks"><Icon name="gem" size={12}/><span data-loot-count aria-label="Collected blocks: 0">0</span><span class="loot-label" data-loot-label>blocks</span></span>}
      <div class="life" role="img" aria-label="Life: five full hearts">{Array.from({length: 5}, () => <Icon name="heart" size={16}/>)}</div>
      <button class="day-toggle" id="day-toggle" type="button" aria-label="Switch to night" aria-pressed="false"><span class="day-icon"><Icon name="sun" size={16}/></span><span class="night-icon"><Icon name="moon" size={16}/></span><span data-time-label>Daytime</span><span aria-hidden="true">↔</span></button>
    </div>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: #121d3a; border-bottom: var(--px) solid #080f25; box-shadow: 0 calc(.5 * var(--px)) 0 #49618b; }
  .header-inner { min-height: calc(25 * var(--px)); display: flex; align-items: center; justify-content: space-between; gap: calc(6 * var(--px)); }
  .brand { display: flex; gap: calc(3 * var(--px)); align-items: center; font-size: calc(7 * var(--px)); font-weight: 700; line-height: 1; letter-spacing: var(--px); }
  .brand img { width: calc(9 * var(--px)); height: calc(9 * var(--px)); }
  .brand-sub { display: block; font-size: calc(2.5 * var(--px)); line-height: 1.5; font-weight: 400; color: var(--color-muted); letter-spacing: calc(.25 * var(--px)); margin-top: calc(2 * var(--px)); }
  .hotbar { display: flex; gap: var(--px); padding-bottom: calc(4 * var(--px)); }
  .hotbar-item { width: calc(14 * var(--px)); height: calc(14 * var(--px)); display: grid; place-items: center; position: relative; border: calc(.5 * var(--px)) solid #6173a3; background: #253769; box-shadow: var(--bevel); color: #b9cafa; }
  .loot-count { display:flex; align-items:center; gap:var(--px); font-size:calc(3 * var(--px)); color:var(--color-accent); }
  .hotbar-item:hover { background: #344982; }
  .hotbar-item.selected { border-color: #edda91; background: #3d4562; color: #f5e3aa; box-shadow: inset 0 0 0 calc(.5 * var(--px)) #917349; }
  .slot-number { position: absolute; top: 0; left: var(--px); font-size: calc(2.5 * var(--px)); color: #bbc4df; }
  .slot-label { position: absolute; top: calc(14 * var(--px)); font-size: calc(3 * var(--px)); }
  .world-controls { display: grid; gap: calc(2 * var(--px)); justify-items: end; }
  .life { display: flex; gap: var(--px); color: #f18b91; filter: drop-shadow(0 var(--px) 0 #813b5a); }
  .day-toggle { display: flex; align-items: center; gap: calc(2 * var(--px)); padding: var(--px) 0; background: transparent; font-size: calc(3 * var(--px)); color: #d7dfef; }
  .day-toggle svg { color: #f5d78c; }
  .day-icon { display:flex; } .night-icon { display:none; }
  :global([data-theme='night']) .day-icon { display:none; }
  :global([data-theme='night']) .night-icon { display:flex; }
  @media (max-width: 760px) { .brand-sub { display:none; } .brand { font-size: calc(6 * var(--px)); } .header-inner { gap: calc(3 * var(--px)); } .hotbar-item { width: calc(12 * var(--px)); height: calc(12 * var(--px)); } .slot-label { top: calc(12 * var(--px)); } }
  @media (max-width: 540px) { .header-inner { min-height: calc(36 * var(--px)); flex-wrap: wrap; padding-block: calc(3 * var(--px)); gap: calc(2 * var(--px)); } .brand { flex: 1; } .brand img { width: calc(7 * var(--px)); height: calc(7 * var(--px)); } .hotbar { order: 3; width: 100%; justify-content: center; } .hotbar-item { width: calc(12 * var(--px)); min-width:calc(12 * var(--px)); height: calc(12 * var(--px)); } .world-controls { display: flex; align-items: center; gap: calc(2 * var(--px)); } .life svg { width: calc(3 * var(--px)); height: calc(3 * var(--px)); } .loot-label { display:none; } }
</style>
<style>
  @media(max-width:540px) { .loot-count { position:absolute; top:calc(11 * var(--px)); right:calc(4 * var(--px)); font-size:calc(2.5 * var(--px)); } }
</style>

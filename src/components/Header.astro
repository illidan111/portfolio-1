---
import Icon from './Icon.astro';
import { features, profile } from '../site.config';
const nav = [ ['home', 'Spawn', 'sword'], ['projects', 'Projects', 'chest'], ['skills', 'Skills', 'pickaxe'], ['about', 'Journey', 'book'], ['contact', 'Contact', 'mail'] ];
const isHome = Astro.url.pathname === '/';
const displayName = profile.name.replace(/\s*\(demo\)$/, '');
---
<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="brand" aria-label={`${displayName} Developer & Explorer — return to spawn`}><img src="/favicon.svg" width="36" height="36" alt=""/><span>{displayName.toUpperCase()} <span class="brand-sub">DEVELOPER & EXPLORER</span></span></a>
    <nav class="hotbar" aria-label="Main navigation">
      {nav.map(([id, label, icon], index) => <a href={isHome ? `#${id}` : `/#${id}`} class:list={['hotbar-item', { selected: id === 'home' && isHome }]} data-nav={id} aria-label={`${label} — shortcut ${index + 1}`} aria-current={id === 'home' && isHome ? 'location' : undefined}><span class="slot-number" aria-hidden="true" data-slot-number={index + 1}></span><Icon name={icon} size={24}/><span class="slot-label">{label}</span></a>)}
      <button class="hotbar-item" type="button" data-open-settings aria-label="Settings — shortcut 6" aria-haspopup="dialog" aria-controls="settings-dialog" aria-expanded="false"><span class="slot-number" aria-hidden="true" data-slot-number="6"></span><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M9 1h6v3h3v3h3v6h-3v3h-3v3H9v-3H6v-3H3V7h3V4h3zm0 6v6h6V7zM4 19h4v4H4zm12 0h4v4h-4z"/></svg><span class="slot-label">Settings</span></button>
    </nav>
    <div class="world-controls">
      {features.digging && <span class="loot-count" title="Collected blocks"><Icon name="gem" size={12}/><span data-loot-count aria-label="Collected blocks: 0">0</span><span class="loot-label" data-loot-label>blocks</span></span>}
      <div class="life" role="img" aria-label="Life: five full hearts">{Array.from({length: 5}, () => <Icon name="heart" size={16}/>)}</div>
      <button class="day-toggle" id="day-toggle" type="button" aria-label="Daytime — Switch to night" aria-pressed="false"><span class="day-icon"><Icon name="sun" size={16}/></span><span class="night-icon"><Icon name="moon" size={16}/></span><span data-time-label>Daytime</span><span aria-hidden="true">↔</span></button>
    </div>
  </div>
  <div class="header-actions container"><a href={`mailto:${profile.email}`}>Email</a><a href={profile.cv} download="cv.pdf" title="Download placeholder CV (PDF)">CV</a><a class="view-toggle" href="/?mode=classic" data-view-link="toggle" data-astro-reload>Classic view</a></div>
</header>
<style>
  .header-actions { display:flex; align-items:center; justify-content:flex-end; gap:calc(2 * var(--px)); padding-bottom:calc(2 * var(--px)); }
  .header-actions a { display:inline-flex; align-items:center; justify-content:center; min-height:calc(11 * var(--px)); padding:calc(2 * var(--px)) calc(3 * var(--px)); background:#253769; border:calc(.5 * var(--px)) solid #6173a3; font-size:calc(4 * var(--px)); }
  .header-actions .view-toggle { border-color:#afc87c; color:var(--color-accent); }
  .site-header { position: sticky; top: 0; z-index: 20; background: #121d3a; border-bottom: var(--px) solid #080f25; box-shadow: 0 calc(.5 * var(--px)) 0 #49618b; }
  .header-inner { min-height: calc(25 * var(--px)); display: flex; align-items: center; justify-content: space-between; gap: calc(6 * var(--px)); }
  .brand { display: flex; gap: calc(3 * var(--px)); align-items: center; font-size: calc(7 * var(--px)); font-weight: 700; line-height: 1; letter-spacing: var(--px); }
  .brand img { width: calc(9 * var(--px)); height: calc(9 * var(--px)); }
  .brand-sub { display: block; font-size:var(--font-caption); line-height: 1.5; font-weight: 400; color: var(--color-muted); letter-spacing: calc(.25 * var(--px)); margin-top: calc(2 * var(--px)); }
  .hotbar { display: flex; gap: var(--px); padding-bottom: calc(4 * var(--px)); }
  .hotbar-item { width: calc(14 * var(--px)); height: calc(14 * var(--px)); display: grid; place-items: center; position: relative; border: calc(.5 * var(--px)) solid #6173a3; background: #253769; box-shadow: var(--bevel); color: #b9cafa; }
  .loot-count { display:flex; align-items:center; gap:var(--px); font-size:var(--font-caption); color:var(--color-accent); }
  .hotbar-item:hover { background: #344982; }
  .hotbar-item.selected { border-color: #edda91; background: #3d4562; color: #f5e3aa; box-shadow: inset 0 0 0 calc(.5 * var(--px)) #917349; }
  .slot-number { position: absolute; top: 0; left: var(--px); font-size:var(--font-caption); color: #bbc4df; }
  .slot-label { position: absolute; top: calc(14 * var(--px)); font-size:var(--font-caption); }
  .world-controls { display: grid; gap: calc(2 * var(--px)); justify-items: end; }
  .life { display: flex; gap: var(--px); color: #f18b91; filter: drop-shadow(0 var(--px) 0 #813b5a); }
  .day-toggle { display: flex; align-items: center; gap: calc(2 * var(--px)); padding: var(--px) 0; background: transparent; font-size:var(--font-caption); color: #d7dfef; }
  .day-toggle svg { color: #f5d78c; }
  .day-icon { display:flex; } .night-icon { display:none; }
  :global([data-theme='night']) .day-icon { display:none; }
  :global([data-theme='night']) .night-icon { display:flex; }
  @media (max-width: 760px) { .brand-sub { display:none; } .brand { font-size: calc(6 * var(--px)); } .header-inner { gap: calc(3 * var(--px)); } .hotbar-item { width: calc(12 * var(--px)); height: calc(12 * var(--px)); } .slot-label { top: calc(12 * var(--px)); } }
  @media (max-width: 540px) { .header-inner { min-height: calc(36 * var(--px)); flex-wrap: wrap; padding-block: calc(3 * var(--px)); gap: calc(2 * var(--px)); } .brand { flex: 0 0 auto; white-space:nowrap; letter-spacing: calc(-.25 * var(--px)); } .brand img { width: calc(7 * var(--px)); height: calc(7 * var(--px)); } .hotbar { order: 3; width: 100%; justify-content: center; } .hotbar-item { width: calc(12 * var(--px)); min-width:calc(12 * var(--px)); height: calc(12 * var(--px)); } .world-controls { display: grid; align-items: center; grid-template-columns:auto auto; gap:var(--px); margin-left:auto; } .life { grid-column:1; grid-row:1; } .day-toggle { grid-column:1 / -1; } .loot-count { grid-column:2; grid-row:1; } .life :global(svg) { width: calc(3 * var(--px)); height: calc(3 * var(--px)); } .loot-label { display:none; } }
</style>
<style>
  @media(max-width:760px) { .slot-label { font-family:Arial,Helvetica,sans-serif; letter-spacing:calc(-.125 * var(--px)); } }
  @media(max-width:540px) {
    .header-inner { min-height:0; padding-block:calc(.75 * var(--px)); gap:var(--px); }
    .header-actions { padding-bottom:var(--px); }
    .hotbar { gap:calc(.25 * var(--px)); padding-bottom:calc(6 * var(--px)); }
    .hotbar-item { flex:1 0 auto; width:max-content; min-width:0; padding:0; border-width:calc(.25 * var(--px)); height:calc(11 * var(--px)); grid-template-rows:calc(10.5 * var(--px)) auto; }
    .slot-label { position:static; font-family:Arial,Helvetica,sans-serif; letter-spacing:calc(-.125 * var(--px)); line-height:1.5; }
    .world-controls { gap:0 var(--px); }
    .loot-count { font-size:var(--font-caption); line-height:1; }
  }
</style>

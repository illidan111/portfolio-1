  <a href="/?mode=classic" data-view-link="classic" data-astro-reload>Classic view <span aria-hidden="true">↗</span></a>
  <button type="button" aria-label="Dismiss view suggestion">×</button>
</aside>
<style>
  .view-notice { display:none; align-items:center; gap:calc(3 * var(--px)); font-size:calc(3.5 * var(--px)); color:var(--color-muted); }
  :global([data-notice-state='show']) .view-notice { display:flex; }
  .view-notice a { display:flex; align-items:center; justify-content:center; gap:var(--px); min-height:calc(11 * var(--px)); padding:calc(2 * var(--px)); color:var(--color-accent); text-decoration:underline; text-underline-offset:var(--px); white-space:nowrap; }
